generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  name          String?
  lastName      String?
  password      String
  phone         String?
  role          Role          @default(STUDENT)
  accountStatus AccountStatus @default(APPROVED)
  emailVerified DateTime?
  // #265: Profil fotoğrafının DEPOLAMA ADI (URL değil). Dosya kendi
  // rotamızdan servis ediliyor; böylece yetki kontrolü her istekte çalışıyor
  // ve içerik tipini istemci değil sunucu belirliyor.
  avatarFile    String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  sessions                 Session[]
  studentProfile           StudentProfile?     @relation("StudentProfile_userIdToUser")
  // #195: Mentor→öğrenci artık M:N (join tablosu). Bir mentörün öğrencileri buradan.
  mentorAssignments        MentorAssignment[]  @relation("MentorAssignment_mentorIdToUser")
  sentMessages             Message[]           @relation("Message_senderIdToUser")
  receivedMessages         Message[]           @relation("Message_receiverIdToUser")
  // #354: "yazıyor..." sinyalleri.
  // #380: Kalıcı bildirimler.
  notifications            Notification[]
  // #398: Ofis saati — açtığı slotlar ve rezerve ettikleri.
  ofisSaatleri             OfisSaatiSlotu[]    @relation("OfisSaati_mentorIdToUser")
  rezervasyonlari          OfisSaatiSlotu[]    @relation("OfisSaati_rezerveEdenIdToUser")
  gonderdigiYaziyor        TypingSignal[]      @relation("TypingSignal_fromUserIdToUser")
  aldigiYaziyor            TypingSignal[]      @relation("TypingSignal_toUserIdToUser")
  stepComments             StepComment[]
  stepFiles                StepFile[]
  suggestions              Suggestion[]        @relation("Suggestion_authorIdToUser")
  // #253: Bu kullanıcının oluşturduğu proje şablonları.
  createdProjectTemplates  ProjectTemplate[]   @relation("ProjectTemplate_createdBy")
  reviewedSuggestions      Suggestion[]        @relation("Suggestion_reviewedByIdToUser")
  // #349: Mentörün açtığı / adminin karara bağladığı çalışma alanı talepleri.
  workspaceRequests        WorkspaceRequest[]  @relation("WorkspaceRequest_requestedByIdToUser")
  decidedWorkspaceRequests WorkspaceRequest[]  @relation("WorkspaceRequest_decidedByIdToUser")
  // #332: Takım mentörlükleri ve üstlenilen adımlar.
  teamMentorships          TeamMentor[]        @relation("TeamMentor_mentorIdToUser")
  assignedSteps            RoadmapStep[]       @relation("RoadmapStep_assignee")
  // #366: Karara bağladığı proje önerileri.
  decidedProposals         ProjectProposal[]   @relation("ProjectProposal_decidedByIdToUser")
  // #287: Mentör başvurusunun cevapları (yalnızca MENTOR rolünde dolu).
  mentorProfile            MentorProfile?      @relation("MentorProfile_userIdToUser")
  stepStatusChanges        StepStatusHistory[]
  /// #321: KVKK AÇIK RIZA — yurt dışına (Google Vertex AI, ABD) aktarım.
  ///
  /// Neden `User` üzerinde: rıza KAYIT ANINDA alınıyor, o noktada
  /// `StudentProfile` henüz oluşmamış oluyor.
  ///
  /// null = rıza YOK. Rıza geri alınabilir olmalı (KVKK m.11), geri alındığında
  /// bu alan tekrar null'a çekilir — tarih silinmez, üzerine yazılır; ispat
  /// yükü veri sorumlusunda olduğu için son durum tutuluyor.
  aiConsentAt              DateTime?
  /// Rızanın alındığı metin sürümü. Metin değişirse eski rıza yeni metni
  /// kapsamaz; hangi sürüme onay verildiği kayıtlı olmalı.
  aiConsentVersion         String?
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StudentProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  experienceLevel String
  interests       String[]
  goals           String?
  availability    String?
  birthYear       Int?

  // #289: Başvuru soruları genişletildi. Hepsi NULLABLE — mevcut profiller
  // geçerli kalsın diye (expand/contract). Zorunluluk formda, şemada değil.

  /// Platformun tüm iş akışı GitHub üzerinden; mentörün bunu bilmesi şart.
  /// Değerler: none | basic | branching | pr
  gitLevel          String?
  /// Açılış sayfası "81 ilde eşleşme" hedefini anlatıyor; il sorulmadan
  /// bu iddia ölçülemiyordu.
  city              String?
  /// Haftada kaç saat. `availability` kovaları ("yarı zamanlı") kişiden
  /// kişiye değişiyordu; saat planlanabilir. availability KORUNUYOR —
  /// eski kayıtlar hâlâ onunla dolu.
  /// #397: "Bir adımda takıldığımda bana haber ver" — VARSAYILAN KAPALI.
  ///
  /// ⚠️ Opt-in bilinçli bir karar ve bedeli biliniyor: tam da hedef kitle
  /// (soru sormaktan çekinen stajyer) bunu açmayı akıl etmeyebilir. Karşılığı,
  /// istenmeyen bir temasın taciz gibi hissettirmemesi. Mentör bildirimi bu
  /// ayardan BAĞIMSIZ çalışır.
  takilmaBildirimi  Boolean   @default(false)
  weeklyHours       Int?
  /// Eğitim durumu — staj eşleştirmesinin en doğal ölçütü.
  school            String?
  department        String?
  /// Sınıf: 1 | 2 | 3 | 4 | hazirlik | mezun | lise | diger
  classYear         String?
  /// Doküman okuma kabiliyeti yol haritasını doğrudan etkiliyor.
  /// Değerler: none | reading | conversational | fluent
  englishLevel      String?
  // #204: Staj başarı sertifikası alanları.
  // #208 review: Seri no belgeyi TEKİL tanımlar; public doğrulama `findFirst` ile
  // arar. Çakışma olursa yanlış belge "geçerli" sayılabilirdi → DB seviyesinde unique.
  certificateNumber String?   @unique
  mentorNote        String?   @db.VarChar(2000)
  completionGrade   String?
  issuedAt          DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  user              User               @relation("StudentProfile_userIdToUser", fields: [userId], references: [id], onDelete: Cascade)
  // #195: Tek mentorId yerine M:N. Bir öğrencinin mentorları buradan.
  mentorAssignments MentorAssignment[]
  assignedProjects  AssignedProject[]
  // #332: Bu stajyerin takım üyelikleri (ayrılmışlar dahil).
  teamMemberships   TeamMember[]
  // #366: Kendi proje önerileri.
  projectProposals  ProjectProposal[]
  surveyAnswers     SurveyAnswer[]
  profileAnalysis   ProfileAnalysis?
}

// #195: Öğrenci↔Mentör M:N eşleştirmesi. Mentorlar eşit yetkili (birincil yok).
model MentorAssignment {
  id               String   @id @default(cuid())
  studentProfileId String
  mentorId         String
  assignedAt       DateTime @default(now())

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  mentor         User           @relation("MentorAssignment_mentorIdToUser", fields: [mentorId], references: [id], onDelete: Cascade)

  // Aynı mentor bir öğrenciye iki kez atanamaz.
  @@unique([studentProfileId, mentorId])
  @@index([mentorId])
}

model ProjectTemplate {
  id            String     @id @default(cuid())
  // #112: Seed idempotency title lookup'ına dayanır; DB seviyesinde de benzersiz olmalı.
  title         String     @unique
  description   String
  track         String[]
  difficulty    Difficulty
  // #49: Projenin GitHub repository URL'i (opsiyonel, public repo).
  githubRepoUrl String?
  // #253: Şablonu oluşturan kişi. Mentör kendi şablonunu düzenleyebilsin,
  // başkasınınkine dokunamasın diye. Nullable: mevcut şablonların sahibi yok
  // (admin tarafından oluşturulmuş sayılırlar) — yalnızca EKLEME, yıkıcı değil.
  // Kullanıcı silinirse şablon durur, sahipsizleşir (SetNull).
  createdById   String?
  /// #366: Bir stajyer önerisinden türetildi mi?
  ///
  /// Öneriden doğan şablon ORTAK HAVUZA girmez: `/api/admin/project-templates`
  /// listesi bunu filtreler. Aksi halde her stajyer önerisi tüm mentörlerin
  /// gördüğü şablon listesini şişirirdi.
  fromProposal  Boolean    @default(false)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  createdBy        User?             @relation("ProjectTemplate_createdBy", fields: [createdById], references: [id], onDelete: SetNull)
  assignedProjects AssignedProject[]

  @@index([createdById])
}

model AssignedProject {
  id String @id @default(cuid())

  /// #332: TAKIM MODELİ İLE NULLABLE OLDU.
  ///
  /// Bireysel atamada dolu, TAKIM atamasında NULL — sahiplik o zaman `teamId`
  /// üzerinden. NOT NULL'dan nullable'a geçiş expand-safe'tir (tersi yıkıcı
  /// olurdu, bkz. `docs/MIGRATIONS.md`); mevcut satırlar aynen geçerli kalır.
  ///
  /// ⚠️ İKİSİNDEN TAM BİRİ dolu olmalı. Prisma bunu ifade edemediği için kısıt
  /// migration'da ham CHECK olarak duruyor (`assigned_project_sahip_tek`).
  studentProfileId  String?
  /// #332: Takım ataması. Bireysel atamada NULL.
  teamId            String?
  projectTemplateId String
  status            AssignmentStatus @default(PENDING)
  githubRepoUrl     String?
  githubStatus      String           @default("NOT_PROVISIONED")
  provisionedAt     DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  studentProfile    StudentProfile?    @relation(fields: [studentProfileId], references: [id])
  team              Team?              @relation(fields: [teamId], references: [id])
  projectTemplate   ProjectTemplate    @relation(fields: [projectTemplateId], references: [id])
  roadmap           Roadmap?
  workspaceRequests WorkspaceRequest[]
  /// #397: Depodaki son commit zamanı (webhook `push` olayından).
  ///
  /// ⚠️ NULL "commit yok" DEĞİL, "VERİ YOK" demek olabilir: BAGLA depolarında
  /// webhook hiç çalışmıyor (#366) ve çalışma alanı kurulmamış atamalarda da
  /// sinyal gelmez. Radar bu ayrımı mentöre AÇIKÇA söylemeli — yoksa "sinyal
  /// yok" ile "veri yok" karışır.
  sonCommitAt       DateTime?

  // #58: Aynı öğrenciye aynı proje şablonu yalnızca bir kez atanabilir (yarış koşulu koruması).
  // Postgres çoklu NULL'a izin verdiği için takım satırları bu kısıtta çakışmaz.
  @@unique([studentProfileId, projectTemplateId])
  // #332: Aynı korumanın takım karşılığı.
  @@unique([teamId, projectTemplateId])
}

model Roadmap {
  id                String        @id @default(cuid())
  assignedProjectId String        @unique
  title             String
  status            RoadmapStatus @default(DRAFT)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  assignedProject AssignedProject @relation(fields: [assignedProjectId], references: [id], onDelete: Cascade)
  steps           RoadmapStep[]
}

model RoadmapStep {
  id             String     @id @default(cuid())
  roadmapId      String
  order          Int
  title          String
  description    String
  resources      String[]
  estimatedHours Int?
  status         StepStatus @default(TODO)
  // #50: Bu adımın bağlı olduğu GitHub issue linki (opsiyonel).
  githubIssueUrl String?
  /// #332: Adımı ÜSTLENEN takım üyesi.
  ///
  /// Adım TAKIMIN; bu alan "kim çekti" bilgisi. Sprint panosunda iş havuzda
  /// durur, biri üzerine alır. Tamamlayan kişi ayrıca
  /// `StepStatusHistory.changedById`'de kayıtlı (#324) — sertifika bireysel
  /// olduğu için katkı bu ikisinden ölçülür.
  /// Bireysel atamalarda NULL kalır; kimse sahip değil, zaten tek kişi var.
  assigneeId     String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  roadmap  Roadmap             @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  assignee User?               @relation("RoadmapStep_assignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  comments StepComment[]
  files    StepFile[]
  issues   StepIssue[]
  history  StepStatusHistory[]
}

/// #324: Adım durum geçişlerinin kaydı.
///
/// NEDEN: `RoadmapStep` yalnızca ANLIK durumu ve `updatedAt`'i tutuyor. Bir
/// adımın ne zaman başladığı, ne zaman bittiği ve arada ne kadar beklediği
/// hiçbir yerde yazılı değil. Planlanan analitik panel (darboğaz analizi,
/// "hangi adımda takılıyorlar", drop-off erken uyarısı) bu veri olmadan
/// hesaplanamaz.
///
/// ZAMANA DUYARLI: Bugün kaydedilmeyen geçiş sonsuza kadar kayıp. Panel çok
/// sonra yapılsa bile kayıt şimdi başlarsa o gün geçmiş veriyle açılır.
model StepStatusHistory {
  id          String   @id @default(cuid())
  stepId      String
  /// İlk kayıtta null olabilir (durum bilinmeyen bir noktadan geliyorsa).
  fromStatus  String?
  toStatus    String
  /// #379: Geçişin gerekçesi. Bugün yalnız REVISION_REQUESTED'da doldurulur
  /// ve ZORUNLUDUR — gerekçesiz revizyon öğrenciye aynı işi tekrar yaptırır
  /// (#366'daki red gerekçesi deseni).
  ///
  /// Adımda değil GEÇİŞTE duruyor: bir adım birden çok kez revize edilebilir
  /// ve her seferin kendi gerekçesi olmalı.
  note        String?  @db.VarChar(1000)
  /// Değişikliği yapan kullanıcı. Hesap silinirse kayıt KALIR (SetNull):
  /// analitik geçmişi tek bir kullanıcı silindi diye bozulmamalı.
  changedById String?
  createdAt   DateTime @default(now())

  step      RoadmapStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  changedBy User?       @relation(fields: [changedById], references: [id], onDelete: SetNull)

  /// Analitik sorguları adım bazında ve zaman sıralı okuyacak.
  @@index([stepId, createdAt])
  @@index([toStatus, createdAt])
}

model StepIssue {
  id              String   @id @default(cuid())
  stepId          String
  order           Int      @default(1)
  title           String
  bodyMarkdown    String   @db.VarChar(4000)
  githubIssueUrl  String?
  status          String   @default("OPEN")
  /// #379: Bu issue MERGE EDİLMİŞ bir PR ile mi kapandı?
  ///
  /// Revizyon istenince GitHub tarafındaki davranışı bu belirliyor:
  ///   merge edildiyse  → YENİ issue açılır (o iş gerçekten bitti, kod ana
  ///                       dalda; eskisini yeniden açmak yapılmamış gibi
  ///                       gösterirdi)
  ///   edilmediyse      → mevcut issue yeniden açılır
  ///
  /// ⚠️ Bu bayraktan ÖNCE kapanmış kayıtlarda `false` kalır. Bilinmeyen
  /// durumda yeniden açma tercih ediliyor: geri alınabilir ve görünür bir
  /// işlem, kopya issue açmaktan daha az gürültülü.
  mergeIleKapandi Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  step RoadmapStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@index([stepId])
}

/// Ofis saati slotu (#398).
///
/// Mentör bir zaman aralığı açar, sistem 20 dakikalık dilimlere böler,
/// stajyer tek tıkla rezerve eder.
///
/// ⚠️ ÇİFT REZERVASYON VERİTABANINDA ENGELLENİR. Rezervasyon "önce sorgula
/// sonra yaz" ile değil, tek bir koşullu UPDATE ile yapılıyor
/// (`WHERE id = ? AND rezerveEdenId IS NULL`). Aynı anda iki stajyer tıklarsa
/// yalnız biri satırı yakalar. #345/#349/#366'daki ders: taramaya değil
/// kısıta/kayda güven.
///
/// ⚠️ Tekrar eden (haftalık) slot YOK — bilinçli. Yineleme kuralı, istisna
/// yönetimi ve takvim genişletmesi ayrı bir iş; somut zaman dilimleri
/// belirsizlik bırakmıyor.
model OfisSaatiSlotu {
  id        String   @id @default(cuid())
  mentorId  String
  /// UTC saklanır, kullanıcıya yerel saatiyle gösterilir.
  baslangic DateTime
  bitis     DateTime

  /// Rezerve eden stajyer. NULL = slot boş.
  rezerveEdenId   String?
  rezerveEdildiAt DateTime?
  /// Stajyerin rezervasyon sırasında yazdığı kısa not.
  ogrenciNotu     String?   @db.VarChar(500)

  /// #398: Görüşme sonrası mentörün KENDİ cümleleriyle yazdığı not.
  ///
  /// ⚠️ AI HİÇ KARIŞMIYOR. Kayıt resmî ve öğrenci hakkında; AI'ın genişlettiği
  /// bir cümle mentörün sözü gibi durur ve öğrenci itiraz ederse kimin sözü
  /// olduğu belirsiz kalır (#328'deki "uydurma kesinlik üretme" sınırı).
  mentorNotu String? @db.VarChar(2000)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mentor      User  @relation("OfisSaati_mentorIdToUser", fields: [mentorId], references: [id], onDelete: Cascade)
  rezerveEden User? @relation("OfisSaati_rezerveEdenIdToUser", fields: [rezerveEdenId], references: [id], onDelete: SetNull)

  /// ⚠️ Aynı mentör aynı ana İKİ slot açamaz — kural VERİTABANINDA.
  ///
  /// Canlı testte bulundu: "Aralık aç" iki kez tıklandığında takvim
  /// ikizleniyordu ve stajyer aynı 14:00 dilimini iki kez görüyordu.
  /// "Önce sorgula sonra yaz" bu yarışı kaybederdi (#345/#349/#366 dersi);
  /// çağıran taraf `skipDuplicates` ile yeniden açmayı idempotent yapıyor.
  @@unique([mentorId, baslangic])
  @@index([mentorId, baslangic])
  @@index([rezerveEdenId, baslangic])
}

/// Kalıcı bildirim (#380).
///
/// ⚠️ NEDEN KALICI — #329'un AKSİNE. Canlı akış olayı yalnız AÇIK sekmeye
/// taşıyor; sekme kapalıysa kaybolur. Bildirimin bütün değeri tam olarak
/// "yokken olanı sonradan görmek". Bu yüzden ayrı bir tabloda duruyor.
///
/// ⚠️ E-POSTA GİTMESE DE SATIR DÜŞER. `mail.ts` yapılandırma yoksa çökmüyor
/// (#241); bildirim de aynı sözleşmeyi koruyor. Tersi olsaydı SMTP
/// kesintisinde bildirimler tamamen kaybolurdu.
model Notification {
  id     String  @id @default(cuid())
  userId String
  /// Olay türü — `features/bildirim/turler.ts` içindeki sabitlerden biri.
  type   String
  title  String  @db.VarChar(200)
  /// Kısa açıklama. Kişisel veri asgaride tutulur (KVKK, #321).
  body   String  @db.VarChar(500)
  /// Tıklanınca gidilecek UYGULAMA İÇİ yol. Harici URL değil.
  link   String? @db.VarChar(300)
  /// #397: Bildirimin BAĞLI OLDUĞU kayıt (ör. adım kimliği).
  ///
  /// Aynı adım için ikinci kez bildirim düşmesin diye var: radar her taramada
  /// aynı takılmayı görecek, ama kullanıcıya bir kez söylenmeli.
  refId  String? @db.VarChar(64)

  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Okunmamış sayacı ve liste bu indekslerden okunuyor.
  @@index([userId, readAt])
  @@index([userId, createdAt])
  /// #397: "bu kişiye bu kayıt için daha önce bildirdik mi" sorgusu.
  @@index([userId, type, refId])
}

/// "Yazıyor..." sinyali (#354).
///
/// ⚠️ SÜREÇ BELLEĞİNDE TUTULAMAZ. Sinyal geçici ama yine de pod'lar arası
/// görünmeli; süreç-yerel bir küme, #329'da mesajlaşma için elenen hatanın
/// aynısı olurdu (A pod'una yazan kullanıcı, B pod'una bağlı karşı tarafta
/// hiç görünmez).
///
/// Satır SAYISI kullanıcı çiftiyle sınırlı, yazma sayısıyla değil: bileşik
/// birincil anahtar sayesinde aktif yazan biri aynı satırı güncelliyor.
model TypingSignal {
  fromUserId String
  toUserId   String
  /// Bu andan sonra sinyal yok sayılır. Gösterge kendiliğinden sönsün diye:
  /// sekmesini kapatan kullanıcı aksi halde sonsuza dek "yazıyor" görünürdü.
  expiresAt  DateTime

  from User @relation("TypingSignal_fromUserIdToUser", fields: [fromUserId], references: [id], onDelete: Cascade)
  to   User @relation("TypingSignal_toUserIdToUser", fields: [toUserId], references: [id], onDelete: Cascade)

  @@id([fromUserId, toUserId])
  @@index([toUserId, expiresAt])
}

model Message {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  content    String   @db.VarChar(2000)
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  sender   User @relation("Message_senderIdToUser", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("Message_receiverIdToUser", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([receiverId, isRead])
  @@index([senderId, receiverId])
}

model StepComment {
  id        String   @id @default(cuid())
  stepId    String
  authorId  String
  content   String   @db.VarChar(1000)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  step   RoadmapStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  author User        @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([stepId])
}

model StepFile {
  id         String   @id @default(cuid())
  stepId     String
  uploaderId String
  fileName   String
  storedName String   @unique
  mimeType   String
  fileSize   Int
  createdAt  DateTime @default(now())

  step     RoadmapStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  uploader User        @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([stepId])
  @@index([uploaderId])
}

// #45: Admin tarafından yönetilen anket soruları havuzu.
// options boşsa serbest metin; doluysa seçenekli soru. isActive=false → pasifleştirilmiş.
model SurveyQuestion {
  id        String   @id @default(cuid())
  question  String
  options   String[] @default([])
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  answers SurveyAnswer[]
}

// #47: AI profil analizinin kalıcı sonucu — öğrenci profiliyle 1-1.
// Profil tamamlandığında/güncellendiğinde üretilip upsert edilir (tek satır).
model ProfileAnalysis {
  id               String   @id @default(cuid())
  studentProfileId String   @unique
  level            String
  summary          String   @db.VarChar(2000)
  strengths        String[]
  developmentAreas String[]
  technicalTracks  String[]
  recommendedPath  String   @db.VarChar(2000)
  recommendations  String[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
}

// #45: Öğrencinin bir ankete verdiği cevap — profile ile ilişkili.
model SurveyAnswer {
  id               String   @id @default(cuid())
  questionId       String
  studentProfileId String
  answer           String   @db.VarChar(2000)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  question       SurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@unique([questionId, studentProfileId])
  @@index([studentProfileId])
}

/// #147: Stajyerin yöneticiye ilettiği öneri/istek kaydı.
model Suggestion {
  id       String           @id @default(cuid())
  authorId String
  type     SuggestionType   @default(SUGGESTION)
  title    String
  content  String
  status   SuggestionStatus @default(OPEN)

  /// Yöneticinin kayda düştüğü yanıt/not (öğrenciye de gösterilir).
  adminNote String?

  reviewedById String?
  reviewedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author     User  @relation("Suggestion_authorIdToUser", fields: [authorId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("Suggestion_reviewedByIdToUser", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([authorId, createdAt])
  @@index([status, createdAt])
}

/// #366: Stajyerin KENDİ proje önerisi.
///
/// Hazır şablonlardan seçmek yerine stajyer kendi projesini önerebiliyor;
/// onaylanınca normal bir atamaya dönüşüyor.
///
/// ÜÇ GITHUB KAYNAĞI tek akışta toplanıyor (`kaynak`):
///   BIZIM   — repoyu biz açarız; provisioning/webhook/AI incelemesi aynen çalışır
///   BAGLA   — stajyerin mevcut deposu atamaya bağlanır, repo AÇILMAZ
///   DEVRET  — depo organizasyona devredilir
///
/// ⚠️ DEVRETMEYİ API'DEN BİZ BAŞLATAMAYIZ. GitHub'ın transfer ucu yalnızca
/// deponun sahibi tarafından çağrılabilir. Yapabildiğimiz: talimat göstermek ve
/// transferin GERÇEKLEŞTİĞİNİ tespit etmek (`repos.get` ile org altında arayarak).
///
/// ⚠️ BAGLA'da otomasyon YOK: depo stajyerin hesabında kaldığı için
/// `GITHUB_TOKEN` orada yetkisiz — webhook (#326) ve AI incelemesi (#327)
/// çalışmaz. #348'deki GitHub App bunu çözer. Arayüz bunu açıkça söylüyor.
model ProjectProposal {
  id               String @id @default(cuid())
  studentProfileId String

  title        String   @db.VarChar(120)
  description  String   @db.VarChar(4000)
  /// Stajyerin bu projeden ne öğrenmeyi hedeflediği.
  goals        String   @db.VarChar(2000)
  technologies String[]

  /// BIZIM | BAGLA | DEVRET — stajyerin TERCİHİ. Nihai karar admin'in.
  kaynak  String  @default("BIZIM")
  /// BAGLA ve DEVRET için zorunlu; BIZIM'de boş.
  repoUrl String?

  /// PENDING | APPROVED | REJECTED
  status      String  @default("PENDING")
  /// Red gerekçesi — RED durumunda ZORUNLU (stajyer nedenini görmeli).
  adminNote   String? @db.VarChar(500)
  /// Admin'in NİHAİ kaynak kararı; stajyerin tercihinden farklı olabilir.
  kararKaynak String?

  decidedById String?
  decidedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  /// Onaylanınca oluşan atama — geri izlenebilirlik için.
  assignedProjectId String? @unique

  /// #345/#349 dersi: bekleyen tekilliği KISITLA korunuyor, taramayla değil.
  /// PENDING iken `studentProfileId`, karar verilince NULL (Postgres çoklu
  /// NULL'a izin verir) — bir stajyerin aynı anda tek bekleyen önerisi olur.
  pendingKey String? @unique

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  decidedBy      User?          @relation("ProjectProposal_decidedByIdToUser", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([studentProfileId])
}

/// #332: Takım/Scrum staj projesi.
///
/// NEDEN VAR: Bugüne kadarki model "1 öğrenci = 1 proje" idi ve bu varsayım
/// şemada kilitliydi. Gerçek iş hayatını simüle etmek için 2-4 kişilik takımlar
/// AYNI panoyu ve AYNI repoyu paylaşıyor.
///
/// SAHİPLİK TAKIMDA, KREDİ KİŞİDE: `AssignedProject` takıma ait (tek kayıt →
/// tek roadmap → tek repo), ama sertifika BİREYSEL kalıyor. Katkı, adımı
/// üstlenen (`RoadmapStep.assigneeId`) ve tamamlayan (`StepStatusHistory
/// .changedById`) kayıtlarından ölçülüyor.
model Team {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members          TeamMember[]
  mentors          TeamMentor[]
  assignedProjects AssignedProject[]
}

/// #332: Takım üyeliği.
model TeamMember {
  id               String @id @default(cuid())
  teamId           String
  studentProfileId String
  /// Takımdaki rol: frontend | backend | qa | fullstack | design
  role             String

  joinedAt DateTime  @default(now())
  /// #332: Ayrılma SİLME DEĞİL, işaretlemedir.
  ///
  /// Satırı silmek, üyenin panodaki katkı geçmişini (üstlendiği adımlar,
  /// tamamladığı işler) sahipsiz bırakırdı; sertifika bireysel olduğu için o
  /// geçmiş kişinin belgesinin dayanağı. Ayrılan üye takımı görmez ama
  /// yaptıkları kayıtlı kalır.
  leftAt   DateTime?

  team           Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@unique([teamId, studentProfileId])
  @@index([studentProfileId])
}

/// #332: Takımın mentörü.
///
/// Mentör TAKIMA atanır; bir üyenin etkin mentörleri = kendi mentörleri (#195)
/// + takımının mentörleri. Bireysel atamalar bozulmadan çalışmaya devam eder.
model TeamMentor {
  teamId   String
  mentorId String

  team   Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  mentor User @relation("TeamMentor_mentorIdToUser", fields: [mentorId], references: [id], onDelete: Cascade)

  @@id([teamId, mentorId])
  @@index([mentorId])
}

/// #349: Mentörün "bu öğrencinin GitHub çalışma alanı kurulsun" talebi.
///
/// NEDEN VAR: Kurulumu tetikleyen uç ADMIN'e kapalı (`requireAuth("ADMIN")`),
/// ama öğrencinin ne zaman hazır olduğunu bilen MENTÖR. Mentör projeyi atıyor,
/// yol haritasını yayınlıyor, sonra bir adminin panele girip düğmeye basmasını
/// bekliyor — ve bu bekleyiş hiçbir yerde KAYITLI DEĞİLDİ. Talep kaydı
/// darboğazı kaldırmıyor, GÖRÜNÜR kılıyor.
///
/// Yetki bilerek mentöre AÇILMADI: repo açmak geri alınamaz ve organizasyonu
/// kirletir; #348'de GitHub App'e verilecek `administration: write` de
/// listedeki en riskli izin.
model WorkspaceRequest {
  id                String @id @default(cuid())
  assignedProjectId String
  requestedById     String
  /// PENDING | APPROVED | REJECTED
  status            String @default("PENDING")

  /// Mentörün gerekçesi (opsiyonel).
  mentorNote String? @db.VarChar(500)
  /// Adminin notu — RED durumunda ZORUNLU. Mentör neden reddedildiğini
  /// görmezse aynı talebi tekrar açar.
  adminNote  String? @db.VarChar(500)

  decidedById String?
  decidedAt   DateTime?
  createdAt   DateTime  @default(now())

  /// Aynı atama için İKİNCİ bir PENDING talebi engelleyen anahtar.
  ///
  /// NEDEN BÖYLE: Kısmi benzersiz indeks (`... WHERE status = 'PENDING'`)
  /// Prisma şemasında ifade edilemiyor ve ham SQL ile eklenirse her
  /// `migrate dev`'de drift üretir. Bu kolon PENDING iken
  /// `assignedProjectId` değerini, karar verilince NULL'ı tutar; Postgres
  /// birden çok NULL'a izin verdiği için karara bağlanmış talepler
  /// birikebilir, ama aynı anda yalnız BİR tanesi bekleyebilir.
  ///
  /// Kısıt VERİTABANINDA: "önce sorgula, yoksa oluştur" iki eşzamanlı istekte
  /// iki talep yaratırdı — #327'de GitHub'ın gecikmeli listesiyle öğrenilen
  /// dersin aynısı, taramaya değil kısıta güvenilir.
  pendingKey String? @unique

  assignedProject AssignedProject @relation(fields: [assignedProjectId], references: [id], onDelete: Cascade)
  requestedBy     User            @relation("WorkspaceRequest_requestedByIdToUser", fields: [requestedById], references: [id], onDelete: Cascade)
  decidedBy       User?           @relation("WorkspaceRequest_decidedByIdToUser", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([assignedProjectId])
}

enum SuggestionType {
  SUGGESTION
  REQUEST
}

enum SuggestionStatus {
  OPEN
  IN_REVIEW
  RESOLVED
}

enum Role {
  ADMIN
  MENTOR
  STUDENT
}

// Stajyer hesap onay durumu. Yeni signup'lar PENDING; admin APPROVED/REJECTED yapar.
// DB default APPROVED → mevcut kullanıcılar ve admin/mentor migration sonrası kilitlenmez.
enum AccountStatus {
  PENDING
  APPROVED
  REJECTED
  GRADUATED
}

enum AssignmentStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum RoadmapStatus {
  DRAFT
  PUBLISHED
}

enum StepStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  /// #379: Mentör "bu adım eksik, revize et" dedi.
  ///
  /// IN_PROGRESS'e geri çekmek yerine AYRI bir durum: revizyon istendiği
  /// bilgisi panoda hiç çalışılmamış bir adımdan ayırt edilebilmeli, ve
  /// StepStatusHistory'de (#324) net bir iz kalmalı — sertifika katkı ölçümü
  /// "tamamladı → geri çekildi" farkını görebilsin.
  REVISION_REQUESTED
}

/// #287: Mentör başvurusunun cevapları.
///
/// Önceden mentörün `User` satırı dışında hiçbir verisi yoktu; admin onay
/// kararını yalnızca ad-soyada bakarak veriyordu. Eşleştirme de kör yapılıyordu.
///
/// StudentProfile ile kasıtlı olarak AYRI: stajyerin ölçüsü "ne öğrenmek
/// istiyor", mentörünki "ne öğretebilir ve ne kadar vakti var".
model MentorProfile {
  id     String @id @default(cuid())
  userId String @unique

  /// Mevcut ünvan — "Senior Backend Developer".
  title           String
  company         String?
  /// Toplam profesyonel yazılım deneyimi (yıl).
  yearsExperience Int
  /// Kıdem kovası: junior | mid | senior | lead. Serbest metin DEĞİL ki
  /// eşleştirme ve analiz tek standartla çalışsın.
  seniority       String
  /// Öğretebileceği alanlar. StudentProfile.interests ile AYNI sözlükten
  /// (models/secenekler) gelir — eşleştirme ancak iki taraf aynı dili
  /// konuşursa çalışır.
  expertise       String[]

  /// Aynı anda kaç stajyer alabileceği.
  capacity    Int @default(1)
  /// Haftada ayırabileceği saat.
  weeklyHours Int

  /// #398: Ofis saati görüşmelerinde kullanılacak bağlantı (Meet/Zoom/…).
  ///
  /// ⚠️ Otomatik Google Meet üretmiyoruz: yeni OAuth akışı, token saklama,
  /// Calendar API kotası ve mentörün takvimine erişim demekti — yani yeni bir
  /// KVKK aydınlatma yüzeyi. #330'da sesli/görüntülü görüşme aynı gerekçeyle
  /// kapatılmıştı. Mentör kendi linkini bir kez giriyor.
  gorusmeLinki String? @db.VarChar(500)

  /// Neden mentörlük yapmak istiyor.
  motivation     String @db.VarChar(2000)
  /// Nasıl bir mentörlük tarzı var — AI eşleştirmesinin en zengin girdisi.
  mentoringStyle String @db.VarChar(2000)

  githubUrl   String?
  linkedinUrl String?
  city        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User            @relation("MentorProfile_userIdToUser", fields: [userId], references: [id], onDelete: Cascade)
  analysis MentorAnalysis?
}

/// #288: Mentör profilinin AI değerlendirmesi.
///
/// `ProfileAnalysis` (stajyer) ile aynı desen, farklı sorular: stajyerde
/// "ne öğrenmeli", mentörde "kime, neyi öğretebilir".
///
/// `level` stajyer analiziyle AYNI sözlüğü kullanır (Başlangıç | Orta | İleri)
/// ki admin iki tarafı yan yana okuyabilsin.
model MentorAnalysis {
  id              String @id @default(cuid())
  mentorProfileId String @unique

  level               String
  summary             String   @db.VarChar(2000)
  /// Mentörün güçlü olduğu alanlar.
  strengths           String[]
  /// Öğretmeye en uygun olduğu teknik alanlar.
  technicalTracks     String[]
  /// Hangi stajyer profiline uygun — eşleştirmenin çekirdeği.
  idealStudentProfile String   @db.VarChar(2000)
  /// Admin'e eşleştirme ipuçları.
  matchingNotes       String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mentorProfile MentorProfile @relation(fields: [mentorProfileId], references: [id], onDelete: Cascade)
}

/// #322: Rate-limit sayaçları — süreç belleği yerine veritabanında.
///
/// NEDEN: Sayaçlar `Map` içinde tutuluyordu ve süreç-yereldi. Birden fazla
/// instance çalıştığında paylaşılmadıkları için brute-force koruması SESSİZCE
/// zayıflıyordu: 5 denemelik login limiti 3 pod'da fiilen 15 oluyordu ve bu
/// hiçbir yerde görünmüyordu.
///
/// Redis yerine Postgres seçildi: veritabanı zaten var, yeni bir altyapı
/// bileşeni ve "Redis düşerse ne olacak" sorusu doğmuyor.
model RateLimit {
  /// "<limiter adı>:<kimlik>" — ör. "login-ip:ip:203.0.113.9"
  key     String   @id
  count   Int
  /// Pencerenin bittiği an. Geçmişte ise sayaç sıfırlanır.
  resetAt DateTime

  /// Süresi dolmuş satırların temizliği için.
  @@index([resetAt])
}

/// #326: İşlenmiş GitHub webhook teslimatları — tekrar-oynatma (replay) koruması.
///
/// NEDEN: GitHub aynı olayı tekrar gönderebiliyor (ağ hatası, elle "Redeliver",
/// yeniden deneme). Aynı teslimatı iki kez işlemek adım durumunu iki kez
/// değiştirir ve durum geçmişine (#324) sahte kayıt düşer.
///
/// Ayrıca güvenlik katmanı: geçerli imzalı bir istek yakalanıp tekrar
/// gönderilse bile ikinci kez işlenmez.
/// #327: Bir PR'a AI incelemesi yazıldığının OTORİTER kaydı.
///
/// NEDEN GEREKLİ — canlı testte bulundu: İdempotens önce yalnızca PR'daki
/// yorumları okuyup kendi işaretimizi aramaya dayanıyordu. GitHub'ın liste
/// uçları ANINDA TUTARLI DEĞİL: aynı depoda yeni açılan bir issue'nun
/// `issues.listForRepo` sonucunda görünmesi gecikebiliyor (aynı hata
/// `issueHazirla`'da KOPYA issue açtırdı). Aynı gecikme `listComments` için de
/// geçerli; birbirine yakın iki teslimat (`opened` + `ready_for_review`) public
/// bir PR'a İKİ yorum bıraktırabilirdi.
///
/// Yorum yazılmadan HEMEN ÖNCE ekleniyor ve benzersizlik ihlali "zaten yazıldı"
/// demek — `ProcessedWebhook` ile aynı desen.
model PullRequestReview {
  id        String   @id @default(cuid())
  repoUrl   String
  prNumber  Int
  createdAt DateTime @default(now())

  @@unique([repoUrl, prNumber])
}

model ProcessedWebhook {
  /// GitHub'ın `X-GitHub-Delivery` başlığındaki benzersiz teslimat kimliği.
  deliveryId String   @id
  event      String
  createdAt  DateTime @default(now())

  /// Eski kayıtların temizliği için.
  @@index([createdAt])
}
