// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN  
  MENTOR
  STUDENT
}

model User {
  id        String    @id @default(cuid())
  email     String   @unique                        
  name      String?    
  lastName  String?                                
  password  String  //hashed password
  phone     String?                                        
  role      Role     @default(STUDENT)                
  createdAt DateTime @default(now())                
  updatedAt DateTime @updatedAt    

  emailVerified DateTime?
  sessions      Session[]
  studentProfile  StudentProfile?  @relation("StudentUser") // Öğrenci profili ilişkisi
  
  // mentorun eşleştiği öğrencileri tutar
  menteeProfiles StudentProfile[] @relation("StudentMentor")

  // Mesajlaşma ilişkileri
  sentMessages     Message[]      @relation("SentMessages")
  receivedMessages Message[]      @relation("ReceivedMessages")
  
  // Adım yorumları
  stepComments     StepComment[]  @relation("StepComments")

  // Güvenlik soruları (şifremi unuttum için)
  securityAnswers  SecurityAnswer[] @relation("SecurityAnswers")

  // Adım dosya yüklemeleri
  stepFiles        StepFile[]       @relation("StepFiles")
}

model Session {
  id           String    @id @default(cuid())
  sessionToken String    @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StudentProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation("StudentUser", fields: [userId], references: [id], onDelete: Cascade)
  birthYear       Int?
  experienceLevel String
  interests       String[]
  goals           String?
  availability    String?

  mentorId        String?
  mentor          User?    @relation("StudentMentor", fields: [mentorId], references: [id])

 assignedProjects AssignedProject[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ProjectTemplate{
  id             String @id @default(cuid())
  title          String
  description    String     //md formatı
  track          String[]   //["web" , "mobile"]
  difficulty     Difficulty
  
  assignedProjects AssignedProject[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum Difficulty{
  HARD
  MEDIUM
  EASY
}

model AssignedProject {
  id                String   @id @default(cuid())
  studentProfileId  String
  projectTemplateId String
  status            AssignmentStatus @default(PENDING)

  studentProfile    StudentProfile @relation(fields: [studentProfileId], references: [id])
  projectTemplate   ProjectTemplate @relation(fields: [projectTemplateId], references: [id])

  // 🚀 SPRINT 3: Bu atanan projenin yol haritası (1-to-1 ilişki)
  roadmap           Roadmap?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

enum AssignmentStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

// ==========================================
// 🚀 SPRINT 3: ROADMAP (YOL HARİTASI) MODELLERİ
// ==========================================

enum RoadmapStatus {
  DRAFT       // AI taslak olarak oluşturdu, mentor henüz onaylamadı
  PUBLISHED   // Mentor onayladı, öğrenci görebilir
}

enum StepStatus {
  TODO
  IN_PROGRESS
  COMPLETED
}

model Roadmap {
  id                String        @id @default(cuid())
  
  // Hangi atanmış projeye ait?
  assignedProjectId String        @unique
  assignedProject   AssignedProject @relation(fields: [assignedProjectId], references: [id], onDelete: Cascade)
  
  title             String
  status            RoadmapStatus @default(DRAFT)
  
  // Yol haritasının adımları (1-to-many ilişki)
  steps             RoadmapStep[]
  
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model RoadmapStep {
  id             String     @id @default(cuid())
  roadmapId      String
  roadmap        Roadmap    @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  
  order          Int        // Adımın sırası (1, 2, 3...)
  title          String     // Örn: "React Router Kurulumu"
  description    String     // Adımın detayı
  resources      String[]   // Faydalı linkler, makaleler (URL dizisi)
  estimatedHours Int?       // Tahmini efor (saat)
  status         StepStatus @default(TODO)

  // Adıma ait yorumlar (mentor-öğrenci)
  comments       StepComment[]

  // Adıma yüklenen dosyalar
  files          StepFile[]

  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

// ==========================================
// 💬 MESAJLAŞMA VE YORUM SİSTEMİ
// ==========================================

model Message {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  content    String   @db.VarChar(2000)
  isRead     Boolean  @default(false)

  sender     User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())

  @@index([senderId, receiverId])
  @@index([receiverId, isRead])
}

model StepComment {
  id        String   @id @default(cuid())
  stepId    String
  authorId  String
  content   String   @db.VarChar(1000)

  step      RoadmapStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  author    User        @relation("StepComments", fields: [authorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stepId])
}

// ==========================================
// 🔐 GÜVENLİK SORULARI (ŞİFREMİ UNUTTUM)
// ==========================================

model SecurityAnswer {
  id         String @id @default(cuid())
  userId     String
  questionId Int       // Önceden tanımlı soru index'i
  answer     String    // Hashlenmiş cevap

  user       User   @relation("SecurityAnswers", fields: [userId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())

  @@unique([userId, questionId])
  @@index([userId])
}

// ==========================================
// 📁 DOSYA YÜKLEME SİSTEMİ
// ==========================================

model StepFile {
  id           String   @id @default(cuid())
  stepId       String
  uploaderId   String
  fileName     String           // Orijinal dosya adı
  storedName   String   @unique // Sunucudaki benzersiz ad
  mimeType     String
  fileSize     Int              // Byte cinsinden
  
  step         RoadmapStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  uploader     User        @relation("StepFiles", fields: [uploaderId], references: [id], onDelete: Cascade)

  createdAt    DateTime @default(now())

  @@index([stepId])
  @@index([uploaderId])
}