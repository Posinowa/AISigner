
# Database (Docker Compose ile ayağa kalkan PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aisigner?schema=public"

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authentication (NextAuth) - Güçlü bir secret oluşturun: openssl rand -base64 32
AUTH_SECRET=change_me

# Uygulamanin ONUNDEKI guvenilen ters vekil (reverse proxy) sayisi.
# Rate-limit istemci IP'sini X-Forwarded-For zincirinden SAGDAN bu kadar sayarak
# okur (lib/client-ip.ts). En soldaki deger istemcinin UYDURDUGU degerdir.
# Tek PaaS yonlendiricisi -> 1 (varsayilan). Onde ayrica CDN varsa -> 2.
# Fazla buyuk vermeyin: zincir kisa kalirsa limit atlatilabilir hale gelir.
# TRUSTED_PROXY_HOPS=1

# (#216) Demo seed şifresi — YALNIZ yerel geliştirme için.
# Verilmezse README'deki yerleşik varsayılan (geçici_şifre) kullanılır.
# Verilirse konsola YAZILMAZ (yalnız "DEMO_PASSWORD env'inden" görünür).
# ⚠️ `npm run seed` production'da ÇALIŞMAZ (kod seviyesinde engellenir);
#    gerçek yönetici hesabı için: npm run create:admin
# DEMO_PASSWORD=

# Google Cloud Vertex AI
# GCP service account JSON dosyasının yolunu belirtin
# Dosya oluşturmak için: https://cloud.google.com/iam/docs/keys-create-delete
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=gcp-credentials.json

# ---------------------------------------------------------------------------
# E-posta (SMTP) — #241
# Tanimli DEGILSE uygulama cokmez; gonderim atlanir ve loglanir.
# 465 -> ortuk TLS, 587 -> STARTTLS. SMTP_SECURE ile elle gecilebilir.
# ---------------------------------------------------------------------------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE=""
SMTP_USER=""
SMTP_PASS=""
# Gonderen adresi SMTP hesabiyla ayni olmali; cogu sunucu farkliysa reddeder.
MAIL_FROM=""

# ---------------------------------------------------------------------------
# Hata bildirimi — #316
# Uretimde yakalanmamis sunucu hatalari bu adrese e-posta ile bildirilir.
# TANIMSIZSA OZELLIK KAPALIDIR (uygulama etkilenmez).
#
# SMTP'ye bagimlidir: sendMail hata firlatmaz, yani SMTP yapilandirilmamissa
# bildirim de sessizce gitmez. Ozellikle bozulan sey SMTP'nin kendisiyse bunu
# haber verecek mekanizma da odur -- gonderim sonucu ayrica loglanir.
#
# Ayni hata en fazla 15 dakikada bir bildirilir; aradaki tekrarlar sayilip
# bir sonraki iletide raporlanir (e-posta seli SMTP hesabini kisitlatir).
# ---------------------------------------------------------------------------
ERROR_ALERT_EMAIL=""

# ---------------------------------------------------------------------------
# GitHub entegrasyonu — #255
# GITHUB_TOKEN tanimli DEGILSE uygulama cokmez: gercek API kullanilmaz ve
# sistem mevcut simulasyon davranisina duser.
#
# Token'in repo acma izni olmali (org icin: admin:org / repo kapsamlari).
# GITHUB_ORG tanimsizsa varsayilan "Posinowa" kullanilir.
# Tanimli ama BOS birakilirsa entegrasyon bilerek devre disi kalir --
# sessizce varsayilana dusmek yanlis hesapta repo acmaya yol acabilir.
# ---------------------------------------------------------------------------
GITHUB_TOKEN=""
GITHUB_ORG="Posinowa"

# ---------------------------------------------------------------------------
# GitHub webhook — #326
# GitHub'dan gelen olaylarin (issue kapandi, PR merge edildi) imzasini
# dogrulamak icin. GitHub repo/org ayarlarinda webhook olustururken girdiginiz
# "Secret" degeriyle AYNI olmali.
#
# TANIMSIZSA UC 503 DONER ve hicbir olay islenmez. Bu bilincli: "sir yoksa gec"
# davranisi, yapilandirma unutuldugunda kimlik dogrulamasiz public bir ucu
# tamamen acik birakirdi.
#
# Uret: openssl rand -hex 32
# ---------------------------------------------------------------------------
GITHUB_WEBHOOK_SECRET=""
