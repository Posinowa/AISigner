
# Database (Docker Compose ile ayağa kalkan PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aisigner?schema=public"

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authentication (NextAuth) - Güçlü bir secret oluşturun: openssl rand -base64 32
AUTH_SECRET=change_me

# (#216) Demo seed şifresi — YALNIZ yerel geliştirme için.
# Verilmezse README'deki yerleşik varsayılan (geçici_şifre) kullanılır.
# Verilirse konsola YAZILMAZ (yalnız "DEMO_PASSWORD env'inden" görünür).
# ⚠️ `npm run seed` production'da ÇALIŞMAZ (kod seviyesinde engellenir);
#    gerçek yönetici hesabı için: npm run create:admin
# DEMO_PASSWORD=

# Google Cloud Vertex AI
# GCP service account JSON dosyasının yolunu belirtin
# Dosya oluşturmak için: https://cloud.google.com/iam/docs/keys-create-delete
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=gcp-credentials.json

# ---------------------------------------------------------------------------
# E-posta (SMTP) — #241
# Tanimli DEGILSE uygulama cokmez; gonderim atlanir ve loglanir.
# 465 -> ortuk TLS, 587 -> STARTTLS. SMTP_SECURE ile elle gecilebilir.
# ---------------------------------------------------------------------------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE=""
SMTP_USER=""
SMTP_PASS=""
# Gonderen adresi SMTP hesabiyla ayni olmali; cogu sunucu farkliysa reddeder.
MAIL_FROM=""

# ---------------------------------------------------------------------------
# GitHub entegrasyonu — #255
# GITHUB_TOKEN tanimli DEGILSE uygulama cokmez: gercek API kullanilmaz ve
# sistem mevcut simulasyon davranisina duser.
#
# Token'in repo acma izni olmali (org icin: admin:org / repo kapsamlari).
# GITHUB_ORG tanimsizsa varsayilan "Posinowa" kullanilir.
# Tanimli ama BOS birakilirsa entegrasyon bilerek devre disi kalir --
# sessizce varsayilana dusmek yanlis hesapta repo acmaya yol acabilir.
# ---------------------------------------------------------------------------
GITHUB_TOKEN=""
GITHUB_ORG="Posinowa"
